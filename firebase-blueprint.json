  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile containing parent or coach contact information (PII restricted to owner and coach)."
    },
    "/athletes/{athleteId}": {
      "schema": { "$ref": "#/entities/Athlete" },
      "description": "Registered athletes at Al-Pop Martial Arts Academy."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily check-in, check-out, and absence records."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Monthly subscription payment records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AcademyNotification" },
      "description": "Real-time notifications sent to parents."
    },
    "/fcmTokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FcmDeviceToken" },
      "description": "FCM Web Push registration tokens isolated per owner device."
    },
    "/pushSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "W3C Web Push device subscriptions isolated per owner and readable by coach for background notification delivery."
    },
    "/parentMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ParentMessage" },
      "description": "Direct messages sent by parents to the coach and coach replies."
    },
    "/registrationRequests/{requestId}": {
      "schema": { "$ref": "#/entities/RegistrationRequest" },
      "description": "Public registration requests submitted by prospective parents, readable and managed exclusively by the coach."
    },
    "/academyHolidays/{holidayId}": {
      "schema": { "$ref": "#/entities/AcademyHoliday" },
      "description": "Training holidays declared by the coach (publicly readable schedule status, coach-only writes)."
    },
    "/catalogPhotos/{photoId}": {
      "schema": { "$ref": "#/entities/CatalogPhoto" },
      "description": "Academy photo catalog entries: coach publishes approved photos immediately; parents submit pending photos for coach approval."
    }
  }
}
