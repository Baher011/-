          "type": "string",
          "maxLength": 160
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "amount": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["نقدي", "إنستاباي", "فودافون كاش", "تحويل بنكي"]
        },
        "paidAt": {
          "type": "string",
          "maxLength": 64
        },
        "recordedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "athleteId",
        "parentUid",
        "parentEmail",
        "month",
        "amount",
        "method",
        "paidAt",
        "recordedBy",
        "notes",
        "createdAt"
