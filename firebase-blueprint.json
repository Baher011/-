{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Account profile for a parent or the academy coach.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^[0-9+\\-\\s]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["parent", "coach"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "phone", "email", "role", "createdAt", "updatedAt"]
    },
    "Athlete": {
      "title": "Athlete",
      "description": "Student athlete registered at Al-Pop Martial Arts Academy.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "athleteCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "parentUid": {
          "type": "string",
          "maxLength": 128
        },
        "parentEmail": {
          "type": "string",
          "maxLength": 160
        },
        "parentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "parentPhone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "age": {
          "type": "number"
        },
        "discipline": {
          "type": "string",
          "enum": ["كيك بوكسينج", "كونغ فو", "MMA"]
        },
        "groupSchedule": {
          "type": "string",
          "maxLength": 120
        },
        "monthlyFee": {
          "type": "number"
        },
        "medicalNotes": {
          "type": "string",
          "maxLength": 300
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "parentUid",
        "parentEmail",
        "parentName",
        "parentPhone",
        "fullName",
        "age",
        "discipline",
        "groupSchedule",
        "monthlyFee",
        "medicalNotes",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily check-in, check-out, and absence log for an athlete.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "athleteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "parentUid": {
          "type": "string",
          "maxLength": 128
        },
        "parentEmail": {
          "type": "string",
          "maxLength": 160
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["present", "checked_out", "absent"]
        },
        "checkInTime": {
          "type": "string",
          "maxLength": 64
        },
        "checkOutTime": {
          "type": "string",
          "maxLength": 64
        },
        "coachNote": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "athleteId",
        "parentUid",
        "parentEmail",
        "date",
        "month",
        "status",
        "checkInTime",
        "checkOutTime",
        "coachNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
